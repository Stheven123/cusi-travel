NODE_ENV=development
PORT=3001

# ── Base de datos ──────────────────────────────────────────────
# Opción A: URL única (Neon, Render, Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Opción B: variables individuales (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cusi_travel
DB_USER=cusi_user
DB_PASSWORD=CHANGE_ME

# ── Seguridad ─────────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_HEX_CHARS
JWT_EXPIRES=24h

# ── CORS ──────────────────────────────────────────────────────
# En producción poner la URL exacta del frontend
CORS_ORIGIN=http://localhost:5173

# TLS para DATABASE_URL (true = valida certificado; false = omite validación, requerido en Neon free tier)
DB_SSL_REJECT_UNAUTHORIZED=false
